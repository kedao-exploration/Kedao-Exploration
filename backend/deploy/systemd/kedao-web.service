[Unit]
Description=Kedao advisor web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eddie-cui
Group=eddie-cui
WorkingDirectory=/home/eddie-cui/code/discover-backend
EnvironmentFile=/home/eddie-cui/code/discover-backend/.env
ExecStart=/home/eddie-cui/code/discover-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/eddie-cui/code/discover-backend/data

[Install]
WantedBy=multi-user.target
